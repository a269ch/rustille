# CMake package configuration for the Rustille C ABI.
#
#   find_package(rustille REQUIRED)
#   target_link_libraries(my_app PRIVATE rustille::rustille)
#
# Generated by scripts/package-c.sh; do not edit by hand.

include(CMakeFindDependencyMacro)

set(RUSTILLE_VERSION "@VERSION@")

get_filename_component(_rustille_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT TARGET rustille::rustille)
  add_library(rustille::rustille SHARED IMPORTED)
  set_target_properties(rustille::rustille PROPERTIES
    IMPORTED_LOCATION "${_rustille_prefix}/lib/@SHARED_LIB@"
    INTERFACE_INCLUDE_DIRECTORIES "${_rustille_prefix}/include")
endif()

if(NOT TARGET rustille::rustille_static)
  add_library(rustille::rustille_static STATIC IMPORTED)
  set_target_properties(rustille::rustille_static PROPERTIES
    IMPORTED_LOCATION "${_rustille_prefix}/lib/@STATIC_LIB@"
    INTERFACE_INCLUDE_DIRECTORIES "${_rustille_prefix}/include"
    INTERFACE_LINK_LIBRARIES "@PRIVATE_LIBS@")
endif()

unset(_rustille_prefix)
